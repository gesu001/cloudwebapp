{
    "title": "RSS API Operations",
    "uid": "rss-api-operations",
    "schemaVersion": 39,
    "version": 1,
    "refresh": "15s",
    "time": {
        "from": "now-15m",
        "to": "now"
    },
    "panels": [
        {
            "id": 1,
            "type": "stat",
            "title": "Requests / second",
            "gridPos": {
                "h": 6,
                "w": 8,
                "x": 0,
                "y": 0
            },
            "targets": [
                {
                    "expr": "sum(rate(rss_api_http_requests_total[5m]))",
                    "refId": "A"
                }
            ]
        },
        {
            "id": 2,
            "type": "stat",
            "title": "Error rate",
            "gridPos": {
                "h": 6,
                "w": 8,
                "x": 8,
                "y": 0
            },
            "targets": [
                {
                    "expr": "sum(rate(rss_api_http_requests_total{status=~\"4..|5..\"}[5m])) / sum(rate(rss_api_http_requests_total[5m]))",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "percentunit"
                }
            }
        },
        {
            "id": 3,
            "type": "timeseries",
            "title": "Request latency p95",
            "gridPos": {
                "h": 8,
                "w": 16,
                "x": 0,
                "y": 6
            },
            "targets": [
                {
                    "expr": "histogram_quantile(0.95, sum(rate(rss_api_http_request_duration_seconds_bucket[5m])) by (le, route))",
                    "legendFormat": "{{route}}",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "s"
                }
            }
        },
        {
            "id": 4,
            "type": "timeseries",
            "title": "Requests by route",
            "gridPos": {
                "h": 8,
                "w": 8,
                "x": 16,
                "y": 6
            },
            "targets": [
                {
                    "expr": "sum by (route) (rate(rss_api_http_requests_total[5m]))",
                    "legendFormat": "{{route}}",
                    "refId": "A"
                }
            ]
        }
    ]
}